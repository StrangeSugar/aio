# 生产环境配置 — deploy/docker-compose.prod.yml
# 复制为 .env 并填入实际值：cp deploy/.env.example deploy/.env

# ═══ LLM 配置（Knowledge Service wiki ingest 需要）═══
LLM_MODE=custom
LLM_PROTOCOL=openai
LLM_PROVIDER=custom
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# ═══ Knowledge Service ═══
KNOWLEDGE_PORT=8424
KNOWLEDGE_PUBLIC_BASE_URL=http://your-server-ip:8424/v3
TMC_CALLBACK_URL=

# ═══ Panel 后端 ═══
PANEL_PORT=8125
METADATA_INSTANCES_CONFIG=./config/metadata-instances.json

# ═══ Web 前端 ═══
WEB_PORT=80
WEB_HTTPS_PORT=443
